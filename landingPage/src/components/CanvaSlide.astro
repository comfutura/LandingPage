---
interface Props {
	id: string;
	stepNumber: number;
	title: string;
	description: string;
	items: string[];
	multipleImages: string[];
	imageAlt: string;
	reversed?: boolean;
}

const {
	id,
	stepNumber,
	title,
	description,
	items,
	multipleImages = [],
	imageAlt,
	reversed = false
} = Astro.props;
---

<div class:list={["canva-slide-inner", { reversed }]}>
	<div class="canva-grid">
		<!-- Info Column -->
		<div class="slide-container">
			<div class="content-card">
				{stepNumber > 0 && <div class="step-badge">PASO {stepNumber.toString().padStart(2, '0')}</div>}
				<div class="card-inner">
					<h2 class="slide-title">{title}</h2>
					<p class="slide-desc">{description}</p>
					
					<ul class="check-list">
						{items.map(item => (
							<li>
								<span class="icon-circle"><i class="fas fa-check"></i></span>
								{item}
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>

		<!-- Visual Column -->
		<div class="canva-visual-panel">
			<div class="canva-image-frame">
				<div class="img-frame">
					<img 
						src={multipleImages[0]} 
						alt={imageAlt} 
						id={`canva-img-${id}`}
						class="canva-main-img"
					/>
				</div>

				{multipleImages.length > 1 && (
					<div class="canva-gallery">
						{multipleImages.map((img, index) => (
							<button 
								class:list={["canva-thumb-btn", { active: index === 0 }]}
								data-src={img}
								data-index={index}
							>
								<img src={img} alt="" />
							</button>
						))}
					</div>
				)}
			</div>
		</div>
	</div>
</div>

<style>
	.canva-slide-inner {
		width: 100%;
		min-height: 100%;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding: 1rem 1.5rem;
	}

	.canva-grid {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: 2.5rem;
		width: 100%;
		max-width: 1600px;
		align-items: flex-start;
		margin: 0 auto;
		padding-top: 8vh;
		transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.reversed .canva-grid { grid-template-columns: 1.2fr 0.8fr; }
	.reversed .slide-container { order: 2; }
	.reversed .canva-visual-panel { order: 1; }

	.slide-container {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.content-card {
		background: rgba(255, 255, 255, 0.03);
		backdrop-filter: blur(30px) saturate(180%);
		-webkit-backdrop-filter: blur(30px) saturate(180%);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 32px;
		padding: 4.5rem 3.5rem;
		position: relative;
		box-shadow: 0 20px 50px rgba(0,0,0,0.4), inset 0 0 20px rgba(255,255,255,0.02);
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		width: 100%;
		max-height: 60vh;
		overflow-y: auto;
		margin-top: 2rem;
		scrollbar-width: thin;
		scrollbar-color: rgba(255,255,255,0.1) transparent;
	}
	.content-card::-webkit-scrollbar { width: 4px; }
	.content-card::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }

	.step-badge {
		position: absolute;
		top: 1.5rem;
		left: 3.5rem;
		background: var(--brand-primary);
		color: #fff;
		padding: 0.5rem 1.2rem;
		border-radius: 50px;
		font-size: 0.7rem;
		font-weight: 900;
		letter-spacing: 2px;
		box-shadow: 0 8px 20px color-mix(in srgb, var(--brand-primary), transparent 60%);
		z-index: 10;
		text-transform: uppercase;
	}

	.slide-title {
		font-size: 2.8rem;
		font-weight: 900;
		margin-bottom: 1.5rem;
		line-height: 1.1;
		letter-spacing: -1.5px;
		background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.6) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.slide-desc { font-size: 1.1rem; color: rgba(255,255,255,0.6); line-height: 1.6; margin-bottom: 2rem; }

	.check-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
	.check-list li { display: flex; align-items: flex-start; gap: 1rem; font-size: 1rem; color: rgba(255,255,255,0.8); line-height: 1.5; }
	.icon-circle {
		width: 24px; height: 24px; min-width: 24px;
		background: color-mix(in srgb, var(--brand-primary), transparent 90%);
		border: 1px solid color-mix(in srgb, var(--brand-primary), transparent 70%);
		border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--brand-primary); font-size: 0.75rem; flex-shrink: 0; margin-top: 0.2rem;
	}

	.canva-visual-panel { height: 100%; max-height: 65vh; display: flex; align-items: center; justify-content: center; min-width: 0; }
	.canva-image-frame { width: 100%; display: flex; flex-direction: column; gap: 1.5rem; position: relative; }

	.img-frame {
		width: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: 24px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 40px 80px rgba(0,0,0,0.6);
		position: relative; display: flex; align-items: center; justify-content: center;
	}

	.canva-main-img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; transition: opacity 0.4s ease; }

	.canva-gallery { display: flex; gap: 0.75rem; justify-content: center; }
	.canva-thumb-btn { width: 64px; height: 40px; border-radius: 8px; background: #111; border: 2px solid transparent; cursor: pointer; overflow: hidden; opacity: 0.4; transition: all 0.4s; }
	.canva-thumb-btn img { width: 100%; height: 100%; object-fit: cover; }
	.canva-thumb-btn.active { opacity: 1; border-color: var(--brand-primary); transform: translateY(-4px) scale(1.05); box-shadow: 0 10px 20px color-mix(in srgb, var(--brand-primary), transparent 70%); animation: pulseMarker 2s infinite; }
	.canva-thumb-btn:hover:not(.active) { opacity: 0.8; transform: translateY(-2px); }

	@keyframes pulseMarker { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--brand-primary), transparent 40%); } 70% { box-shadow: 0 0 0 10px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

	/* Responsiveness */
	@media (max-width: 1200px) {
		.slide-title { font-size: 2.5rem; }
		.content-card { padding: 2.5rem; }
	}

	@media (max-width: 1024px) {
		.canva-slide-inner { padding: 0.5rem; }
		.canva-grid { display: flex !important; flex-direction: column !important; gap: 0.25rem !important; }
		.canva-visual-panel { order: -1; width: 100%; flex: 1.1; min-height: 0; }
		.slide-container { padding: 1.25rem; background: rgba(0,0,0,0.4); border-top: 1px solid rgba(255,255,255,0.08); border-radius: 20px; margin: 0.5rem; }
		.content-card { padding: 1.5rem; border-radius: 16px; backdrop-filter: none; background: transparent; border: none; box-shadow: none; }
		.slide-title { font-size: 1.8rem; letter-spacing: -0.5px; margin-bottom: 0.75rem; }
		.slide-desc { font-size: 1rem; margin-bottom: 1.25rem; line-height: 1.5; opacity: 0.8; }
		.check-list { gap: 0.75rem; }
		.check-list li { font-size: 0.95rem; line-height: 1.4; }
		.icon-circle { width: 22px; height: 22px; font-size: 0.7rem; }
		.img-frame { border-radius: 12px; }
		.step-badge { top: -10px; left: 20px; font-size: 0.65rem; padding: 0.4rem 1rem; }
	}
</style>

<script is:inline>
	document.querySelectorAll('.canva-thumb-btn').forEach(btn => {
		btn.onclick = () => {
			const panel = btn.closest('.canva-visual-panel');
			const display = panel.querySelector('.canva-main-img');
			display.src = btn.dataset.src;
			panel.querySelectorAll('.canva-thumb-btn').forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
		};
	});
</script>
