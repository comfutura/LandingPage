---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "Manuales de Usuario - SSOMA Comfutura" } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
		<!-- Font Awesome -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
	</head>
	<body class="bg-mesh">
		<div class="mesh-container">
			<div class="mesh-glow blob-1"></div>
			<div class="mesh-glow blob-2"></div>
			<div class="mesh-glow blob-3"></div>
		</div>
		<slot />
	</body>

	<style is:global>
		.bg-mesh {
			position: relative;
			background: var(--ssoma-black);
		}
		.mesh-container {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			z-index: -1;
			overflow: hidden;
			background: var(--mesh-bg);
		}
		.mesh-glow {
			position: absolute;
			width: 60vw;
			height: 60vw;
			border-radius: 50%;
			filter: blur(120px);
			opacity: 0.4;
			animation: float 20s infinite alternate;
		}
		.blob-1 {
			top: -10%;
			left: -10%;
			background: radial-gradient(circle, var(--ssoma-red) 0%, transparent 70%);
		}
		.blob-2 {
			bottom: -10%;
			right: -10%;
			background: radial-gradient(circle, #440000 0%, transparent 70%);
		}
		.blob-3 {
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			background: radial-gradient(circle, #111 0%, transparent 70%);
		}

		@keyframes float {
			from { transform: translate(0, 0) scale(1); }
			to { transform: translate(10%, 10%) scale(1.1); }
		}
	</style>
</html>
